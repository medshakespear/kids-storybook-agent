# Paste your own credentials here, in .env.local (not this example).
# At least one Gemini key and one Cloudflare token/account pair are required.
TEXT_PROVIDER=gemini
IMAGE_PROVIDER=cloudflare
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN_1=
CLOUDFLARE_API_TOKEN_2=
CLOUDFLARE_API_TOKEN_3=
CLOUDFLARE_API_TOKEN_4=
# If tokens belong to different accounts, fill the corresponding IDs below.
CLOUDFLARE_ACCOUNT_ID_1=
CLOUDFLARE_ACCOUNT_ID_2=
CLOUDFLARE_ACCOUNT_ID_3=
CLOUDFLARE_ACCOUNT_ID_4=
# Optional: reuse your previous model ID by uncommenting and editing this line.
# GEMINI_TEXT_MODEL=your-model-id
DAILY_BOOK_COUNT=1
BOOK_TIMEZONE=Africa/Casablanca
LOCAL_PORT=8080
# 0 = manual generation only; 1 = automatic daily batch while the app is running.
LOCAL_AUTO_DAILY=0
LOCAL_DAILY_TIME=09:00
# Optional access key for generation. Leave blank for your loopback-only app.
WEBHOOK_API_KEY=
